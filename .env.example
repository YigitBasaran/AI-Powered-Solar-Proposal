APP_ENV=development
LOG_LEVEL=INFO

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=sqlite+aiosqlite:///./solarvis.db

# Leave empty when running from a checkout; Docker sets it to /fixtures.
FIXTURES_DIR_OVERRIDE=

# ---------------------------------------------------------------------------
# Case location.
#
# The case brief prints the latitude WITHOUT a minus sign. That coordinate is
# open Mediterranean sea and cannot be used. Both values are kept: the raw
# value exactly as the brief wrote it, and the resolved value actually used.
# Evidence: docs/location-verification.md
# ---------------------------------------------------------------------------
CASE_RAW_LATITUDE=34.04658242871865
CASE_RAW_LONGITUDE=18.46491476666948
CASE_RESOLVED_LATITUDE=-34.04658242871865
CASE_RESOLVED_LONGITUDE=18.46491476666948

# ---------------------------------------------------------------------------
# Maps. There is no imagery mode: every request for the satellite raster is a
# real HTTP request to the URL below, and a failed one is an error rather than
# a substituted file. A committed raster served in place of a failed fetch is
# how a correct-looking roof outline ends up drawn over the wrong picture.
#
# **A Google Maps API key is required to run the application.** Tests do not
# need one: they point GOOGLE_STATIC_MAPS_BASE_URL at a local stub.
#
# The roof calibration is bound to this exact configuration by two signatures.
# The request signature covers centre, zoom, size, scale, map type and the
# raster geometry that follows from them; changing any of them fails start-up
# with the field named, because the stored pixels then describe a different
# grid. The imagery signature is a perceptual hash of what Google actually
# returns; if the tile is re-flown, the map still renders but measurement,
# panel layout and finalisation stop until the roof is re-traced.
# ---------------------------------------------------------------------------
GOOGLE_STATIC_MAPS_BASE_URL=https://maps.googleapis.com/maps/api/staticmap
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ZOOM=20
GOOGLE_MAPS_SIZE=640x640
GOOGLE_MAPS_SCALE=2
GOOGLE_MAPS_MAPTYPE=satellite

# Which roof calibration profile to measure from. Empty means the committed
# Google profile; the tests point this at one bound to the stub's raster, so
# the verification guard runs for real rather than being switched off. There
# is deliberately no "skip verification" flag.
ROOF_CALIBRATION_PATH=

# PVGIS has no mode. Every analysis makes a real HTTP call to this URL, and
# an analysis that cannot make one fails rather than substituting a capture.
# The consequence is deliberate: an offline deployment cannot complete an
# analysis. The test suites stay offline by pointing this at a local replay
# server; the application does not.
#
# Only `https://re.jrc.ec.europa.eu/api/v5_3` is proposal-grade. Anything else
# -- another origin, another API version, plain HTTP -- is labelled `replay`
# and cannot be finalised. If PVGIS ever moves, proposals stop being classified
# live until this and the trusted constant are updated together, deliberately.
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
PVGIS_SYSTEM_LOSS_PERCENT=14
PVGIS_TECHNOLOGY=crystSi
PVGIS_MOUNTING_PLACE=building
PVGIS_TIMEOUT_SECONDS=15

# How hard one facet probe tries before the whole analysis fails. Two bounds,
# whichever binds first. The four facets are probed concurrently, so a bad PVGIS
# day costs roughly one budget in wall-clock rather than four.
PVGIS_MAX_ATTEMPTS=4
PVGIS_RETRY_BUDGET_SECONDS=30
PVGIS_RETRY_BASE_DELAY_SECONDS=0.5
PVGIS_RETRY_MAX_DELAY_SECONDS=8

# How long one analysis batch holds its claim on a project. Validated against
# the worst-case external-call window: a lease shorter than the work it protects
# hands the project to a second batch while the first is still running.
ANALYSIS_LEASE_SECONDS=120

# Permit a proposal backed by a replayed capture rather than a live PVGIS
# observation. **Leave this false.** It exists only so the stub-backed test
# harnesses can exercise finalisation, and start-up *refuses* it outside a
# recognised test environment -- setting it true here fails the container.
ALLOW_REPLAY_PROPOSALS=false

# ---------------------------------------------------------------------------
# FX. There is deliberately no CASE_USD_EUR_RATE setting: a hardcoded parity
# assumption is never permitted. Fallback order is live -> cache -> labelled
# fixture, and the source is always surfaced in the UI and the PDF.
# ---------------------------------------------------------------------------
FX_MODE=live
FX_PROVIDER=frankfurter
FX_DATA_PROVIDER=ECB
FX_BASE_URL=https://api.frankfurter.dev/v2
FX_BASE_CURRENCY=USD
FX_QUOTE_CURRENCY=EUR
FX_TIMEOUT_SECONDS=5
FX_CACHE_TTL_HOURS=24
FX_FALLBACK_ENABLED=true
FX_MAX_CACHED_RATE_AGE_DAYS=7

# ---------------------------------------------------------------------------
# Local LLM. Default `rules` so the full flow works with no model pulled.
# Switch to `ollama` after: docker compose --profile ollama up -d
#                           docker compose exec ollama ollama pull qwen3.5:2b
# ---------------------------------------------------------------------------
LLM_PROVIDER=rules
LLM_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SECONDS=20
# How long finalising a proposal will wait for the optional executive summary.
# Shorter than the transport timeout on purpose: the deterministic template is
# always ready, and a proposal must not be held open for prose that is an
# improvement rather than a requirement.
SUMMARY_TIMEOUT_SECONDS=15

# --- email ------------------------------------------------------------------
#
# `console` renders the message, logs it and sends NOTHING. `smtp` hands it to
# a relay. There is deliberately no third option and no vendor SDK.
#
# There is also no fallback: `smtp` with a blank SMTP_HOST reports unavailable
# and the send route returns 503. It never quietly downgrades to console,
# because that would report a message that never left the building.
#
# `smtp` is REFUSED outright when APP_ENV is test/e2e/verification — the
# settings fail to construct, so an automated run cannot send real mail even if
# it is handed a real relay.
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Bounds the whole send attempt. Short on purpose: the send happens inside a
# request, and a relay that hangs would otherwise hold a worker until the
# client gave up, leaving a delivery whose outcome nobody can determine.
SMTP_TIMEOUT_SECONDS=10

# The envelope sender. Required for EMAIL_MODE=smtp and deliberately not
# defaulted — a plausible-looking default is how mail starts arriving from a
# domain nobody controls.
EMAIL_FROM=
EMAIL_FROM_NAME=SolarVis
EMAIL_REPLY_TO=

# Where the "your proposal was opened" notification goes. Empty disables it.
SALESPERSON_EMAIL=

# Master switch for outbound proposal email, independent of the provider.
PROPOSAL_EMAIL_ENABLED=true

# Whether the rendered PDF is attached to the proposal email. Off by default:
# rendering runs Chromium inside the request, attachments hurt deliverability,
# and the artefact this product issues is a web page — the link is the
# deliverable.
PROPOSAL_EMAIL_ATTACH_PDF=false

# --- proposal view tracking ---------------------------------------------------
#
# Salt for the stored view hash. Without one, sha256(ip) is a lookup table: the
# IPv4 space is small enough to enumerate in full, so an unsalted digest
# identifies the address exactly. Set this to any per-deployment secret.
VIEW_HASH_SALT=

# How long after a counted view an identical one is treated as the same visit.
# The share page posts on every mount, so without this a customer scrolling
# back and forth reads as several separate openings.
PROPOSAL_VIEW_DEDUP_MINUTES=30

CASE_CAPEX_AMOUNT=10000
CASE_CAPEX_CURRENCY=USD

# The electricity price used when a project has not set its own. A customer can
# change theirs in conversation ("my tariff is 0.31 EUR/kWh"); that is stored
# per project and moves savings and payback only - never the roof, the layout
# or the modelled production, none of which depend on what electricity costs.
CASE_ELECTRICITY_PRICE=0.25
CASE_ELECTRICITY_CURRENCY=EUR

PANEL_WIDTH_M=1.0
PANEL_HEIGHT_M=2.0
PANEL_POWER_WP=400
PANEL_GAP_M=0.02
ROOF_EDGE_SETBACK_M=0.0
ROOF_PITCH_DEG=25

# Angular step for the per-facet array-rotation search. 0 disables it and every
# array is laid parallel to its facet's eave - the only geometry a standard
# rail-and-clamp mounting system supports. Non-zero lets each facet's array be
# turned to fit more panels; on the case roof that is +1 panel on the east
# triangle at 45 deg, and it needs bespoke sub-framing to build.
# See docs/known-limitations.md#rotated-arrays-are-not-buildable-as-drawn
PANEL_ROTATION_STEP_DEG=5
PANEL_ROTATION_MAX_DEG=90
